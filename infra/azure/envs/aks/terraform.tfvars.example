# Copy to terraform.tfvars (gitignored) and fill in your own values.
# Every ID below is a placeholder, not a real one; CI and offline checks use it as-is.
subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"
key_vault_id    = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-ccai-bootstrap/providers/Microsoft.KeyVault/vaults/kv-ccai-xxxxxx"

# Destroy by this date; it is tagged on every resource.
session_expires = "2026-11-10"

# Your public IPv4 (Postgres firewall) and Entra object ID (ADLS access, AKS cluster admin).
operator_ip        = "203.0.113.10"
operator_object_id = "00000000-0000-0000-0000-000000000000"

# Cluster size (cost guardrail): one Standard_D4s_v5 node, autoscaled to two at most.
# kubernetes_version = "1.35"
# node_vm_size       = "Standard_D4s_v5"
# node_min_count     = 1
# node_max_count     = 2

# Regions when location hits a capacity or quota error; each defaults to location.
# aks_location  = "eastus2"
# data_location = "centralus"

enable_app_routing_gateway = true
enable_container_insights  = false
