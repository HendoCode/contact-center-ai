# generated by `data/synthetic/generate_data.py` — deterministic, not source
data/synthetic/*.json

# Environment
.env
.env.*
!.env.example

# Local public-safety deny-list (private to the repo owner — never committed)
.forbidden_strings.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Local LanceDB store (generated by RETRIEVER_BACKEND=lancedb ingest)
data/lance/

# Data — never commit real call data
data/real/
data/recordings/
*.mp3
*.wav
*.m4a

# Terraform state — contains secrets
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/.terraform.lock.hcl
infra/terraform/terraform.tfvars

# Terraform (infra/azure): lock files ARE committed per root; state, backend
# config and real tfvars are not. Copy the *.example files to fill them in.
infra/azure/**/.terraform/
infra/azure/**/*.tfstate
infra/azure/**/*.tfstate.*
infra/azure/**/backend.hcl
infra/azure/**/*.tfvars
infra/azure/**/*.tfvars.json
!infra/azure/**/*.tfvars.example
infra/azure/**/crash.log
# only roots (bootstrap, envs/*) pin providers; modules inherit from the root
infra/azure/modules/**/.terraform.lock.hcl

# Claude Code local settings
.claude/settings.local.json

# IDE (See IDEA below, too)
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# dbt (generated at runtime; project source is olap/dbt/*.yml + models/)
target/
dbt_packages/
.user.yml

# Structurizr — generated at runtime, only workspace.dsl is source
docs/architecture/workspace.json
docs/architecture/.structurizr/

# Covers JetBrains IDEs: IntelliJ, RubyMine, PhpStorm, AppCode, PyCharm, CLion, Android Studio and Webstorm
# Reference: https://intellij-support.jetbrains.com/hc/en-us/articles/206544839

*.jar
!gradle-wrapper.jar

# User local IDEA configuration files
.idea/
.run/

# IntelliJ project
*.iml

# User local IDEA run configurations
.run/

# Build output & caches for IntelliJ plugin development
build/
idea-sandbox/
.gradle/

