# 1Password references for `tools/warehouse-run.sh snowflake` (resolved by `op run`, never
# stored). Field names match the CMW/snowflake-ccai item. SNOWFLAKE_ADMIN_* fields in that
# item are Terraform's and are deliberately not referenced here. The keys have no
# passphrase; for an encrypted key add
#   SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=op://CMW/snowflake-ccai/SNOWFLAKE_PRIVATE_KEY_PASSPHRASE
SNOWFLAKE_ACCOUNT=op://CMW/snowflake-ccai/SNOWFLAKE_ACCOUNT
SNOWFLAKE_USER=op://CMW/snowflake-ccai/SNOWFLAKE_USER
SNOWFLAKE_ROLE=op://CMW/snowflake-ccai/SNOWFLAKE_ROLE
SNOWFLAKE_WAREHOUSE=op://CMW/snowflake-ccai/SNOWFLAKE_WAREHOUSE
SNOWFLAKE_DATABASE=op://CMW/snowflake-ccai/SNOWFLAKE_DATABASE
SNOWFLAKE_SCHEMA=op://CMW/snowflake-ccai/SNOWFLAKE_SCHEMA
SNOWFLAKE_PRIVATE_KEY_PEM=op://CMW/snowflake-ccai/SNOWFLAKE_PRIVATE_KEY_PEM
