# Keys for `tools/evals-live-run.sh` (make evals-live). No vault path is committed: each
# value names the environment variable that holds YOUR 1Password reference, and the runner
# substitutes it before `op run` resolves the secret. For example:
#   export LANGSMITH_KEY_REF='op://<your vault>/<LangSmith item>/credential'
#   export EVALS_OPENAI_KEY_REF='op://<your vault>/<OpenRouter item>/credential'
# OPENAI_API_KEY is an OpenRouter key: it pays for the agent and the judge.
LANGSMITH_API_KEY=${LANGSMITH_KEY_REF}
OPENAI_API_KEY=${EVALS_OPENAI_KEY_REF}
