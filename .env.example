# LLM provider: "openai" (default, any OpenAI-compatible endpoint), "ollama",
# "anthropic", "fireworks", or "vllm"
LLM_PROVIDER=openai

# Retrieval backend: "pgvector" (default) or "lancedb" (install with `uv sync --group lance`)
RETRIEVER_BACKEND=pgvector

# LanceDB (RETRIEVER_BACKEND=lancedb): embedded, no server. A local directory, or an
# az:// / s3:// URI for the cloud profile (credentials come from the environment).
LANCE_URI=data/lance

# Chat LLM (OpenAI-compatible). Defaults route to a low-cost OpenRouter model:
# set OPENAI_API_KEY to a scoped OpenRouter key and no other chat config is needed.
OPENAI_API_KEY=sk-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-5.3-flash

# Embeddings. OpenRouter serves no embedding models, so when chat goes through
# OpenRouter pair it with the local (free) Ollama embeddings path:
EMBEDDING_PROVIDER=ollama

# Anthropic (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Fireworks AI (LLM_PROVIDER=fireworks; served via the OpenAI-compatible client)
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama4-scout-instruct-basic

# vLLM (LLM_PROVIDER=vllm; self-hosted OpenAI-compatible server)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
# OpenAI-compatible embeddings (used when EMBEDDING_PROVIDER=openai):
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1

# Ollama (chat when LLM_PROVIDER=ollama; embeddings when EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# PostgreSQL with pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contactcenter
COLLECTION_NAME=call_transcripts

# S3 (call data staging)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_PREFIX=call-data/

# Azure / Entra (production auth only — not needed for local dev)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Compose (docker-compose.yml). Optional profiles: `app` (the `make demo` stack), `gpu` (vllm).
# `make demo` runs the keyless local path (chat and embeddings on Ollama). To change the
# demo's chat provider, pass it to make or export it in the shell; .env is not read by make:
#   make demo DEMO_LLM_PROVIDER=openai
# DEMO_LLM_PROVIDER=ollama
# Hugging Face token for gated models served by the `gpu` profile (vllm, e.g. Llama):
HF_TOKEN=

# dbt warehouse targets (olap/dbt/profiles.yml). The default `dev` target is the Compose
# Postgres and needs none of these. Install adapters with `uv sync --group dbt --group snowflake`
# (or `--group databricks`) and run `dbt build --target snowflake|databricks`.
# Snowflake: key-pair auth only, no password. The private key is a PKCS#8 PEM file on disk.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=marts
# Schema the loaders write the raw OLTP tables to, and the dbt source schema (olap/dbt/loaders)
SNOWFLAKE_RAW_SCHEMA=raw
# Databricks (SQL warehouse + Unity Catalog)
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=marts
# Schema (in DATABRICKS_CATALOG) the loaders write the raw OLTP tables to, and the dbt source schema
DATABRICKS_RAW_SCHEMA=raw

# MCP server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000

# LangSmith tracing (L2). Off unless LANGSMITH_TRACING=true; the key alone does not trace.
# Tests and the offline `make evals` force it off.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=contact-center-ai

# `make evals-live` LLM-as-judge: "anthropic" (default) or "openai" (OpenAI-compatible,
# LLM_BASE_URL). The judge model must differ from the agent's model; the run refuses otherwise.
EVAL_JUDGE_PROVIDER=anthropic
EVAL_JUDGE_MODEL=claude-opus-5-5
