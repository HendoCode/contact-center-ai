# LLM provider: "openai" (default, any OpenAI-compatible endpoint), "ollama",
# "anthropic", "fireworks", or "vllm"
LLM_PROVIDER=openai

# Retrieval backend: "pgvector" (default) or "lancedb" (install with `uv sync --group lance`)
RETRIEVER_BACKEND=pgvector

# LanceDB (RETRIEVER_BACKEND=lancedb): embedded, no server. A local directory, or an
# az:// / s3:// URI for the cloud profile (credentials come from the environment).
LANCE_URI=data/lance

# Chat LLM (OpenAI-compatible). Defaults route to a low-cost OpenRouter model:
# set OPENAI_API_KEY to a scoped OpenRouter key and no other chat config is needed.
OPENAI_API_KEY=sk-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-5.3-flash

# Embeddings. OpenRouter serves no embedding models, so when chat goes through
# OpenRouter pair it with the local (free) Ollama embeddings path:
EMBEDDING_PROVIDER=ollama

# Anthropic (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Fireworks AI (LLM_PROVIDER=fireworks; served via the OpenAI-compatible client)
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama4-scout-instruct-basic

# vLLM (LLM_PROVIDER=vllm; self-hosted OpenAI-compatible server)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
# OpenAI-compatible embeddings (used when EMBEDDING_PROVIDER=openai):
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1

# Ollama (chat when LLM_PROVIDER=ollama; embeddings when EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# PostgreSQL with pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contactcenter
COLLECTION_NAME=call_transcripts

# S3 (call data staging)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_PREFIX=call-data/

# Azure / Entra (production auth only — not needed for local dev)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# MCP server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
